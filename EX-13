import math

def minimax(depth, node_index, is_maximizing, scores, height):
    # Base case: reached leaf node
    if depth == height:
        return scores[node_index]

    if is_maximizing:
        best = -math.inf
        # Recur for left and right children (branching factor = 2)
        for i in range(2):
            val = minimax(depth + 1, node_index * 2 + i, False, scores, height)
            best = max(best, val)
        return best
    else:
        best = math.inf
        for i in range(2):
            val = minimax(depth + 1, node_index * 2 + i, True, scores, height)
            best = min(best, val)
        return best

if __name__ == "__main__":
    # Terminal leaf utilities (left to right)
    scores = [3, 5, 2, 9, 12, 5, 23, 23]
    tree_height = int(math.log2(len(scores)))

    optimal_value = minimax(0, 0, True, scores, tree_height)
    print(f"Leaf values: {scores}")
    print(f"The optimal value evaluated by Minimax is: {optimal_value}")
