% Connected city facts

connected(hyderabad, bangalore).
connected(hyderabad, chennai).
connected(bangalore, mumbai).
connected(chennai, kerala).
connected(mumbai, delhi).
connected(kerala, delhi).

% Path finding rule

path(Start, Goal, Path) :-
    travel(Start, Goal, [Start], ReversePath),
    reverse(ReversePath, Path).

travel(Goal, Goal, Visited, Visited).

travel(Current, Goal, Visited, Path) :-
    connected(Current, Next),
    \+ member(Next, Visited),
    travel(Next, Goal, [Next|Visited], Path).
